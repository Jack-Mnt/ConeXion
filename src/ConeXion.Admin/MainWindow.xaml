<Window x:Class="ConeXion.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConeXion Admin" Width="840" Height="620" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource JmBrush.Background}"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="ConeXion.ico">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource JmBrush.Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource JmBrush.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource JmBrush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="28,24,28,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="ConeXion.ico" Width="48" Height="48" Margin="0,0,13,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ConeXion Admin" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource JmBrush.TextPrimary}" />
                    <TextBlock Text="Panel de administración" Foreground="{StaticResource JmBrush.TextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,22,0,0">
                <!-- Unprovisioned -->
                <Border x:Name="UnprovisionedPanel" Background="White" BorderBrush="{StaticResource JmBrush.Border}" BorderThickness="1" CornerRadius="12" Padding="28">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
                        <TextBlock Text="Configurar esta computadora" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource JmBrush.TextPrimary}" />
                        <TextBlock Text="Selecciona el archivo de configuración proporcionado." Foreground="{StaticResource JmBrush.TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,24" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Cargar archivo TXT" Click="LoadTxt_Click" Height="44" MinWidth="200" />
                        <Border x:Name="PreviewCard" Visibility="Collapsed" Background="{StaticResource JmBrush.SurfaceAlt}" CornerRadius="9" Padding="16" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Configuración detectada" FontWeight="SemiBold" Foreground="{StaticResource JmBrush.TextPrimary}" />
                                <TextBlock x:Name="PreviewText" Margin="0,10,0,14" Foreground="{StaticResource JmBrush.TextSecondary}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Aplicar configuración" Click="ApplyConfig_Click" Height="42" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ProvisionMessage" Text="" Foreground="{StaticResource JmBrush.Error}" TextWrapping="Wrap" Margin="0,14,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Provisioned -->
                <Grid x:Name="ProvisionedPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource JmBrush.Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Instalación" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource JmBrush.TextPrimary}" />
                                <TextBlock x:Name="InstallationText" Margin="0,10,0,0" Foreground="{StaticResource JmBrush.TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Catálogo" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource JmBrush.TextPrimary}" />
                                <TextBlock x:Name="CatalogAdminText" Margin="0,10,0,0" Foreground="{StaticResource JmBrush.TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="{StaticResource JmBrush.Border}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,16,8,0">
                        <StackPanel>
                            <TextBlock Text="Diagnóstico" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource JmBrush.TextPrimary}" />
                            <TextBlock x:Name="DiagnosticResult" Margin="0,12,0,16" Foreground="{StaticResource JmBrush.TextSecondary}" TextWrapping="Wrap" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Ejecutar diagnóstico" Click="Diagnostic_Click" Height="40" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Exportar diagnóstico" Click="ExportDiagnostic_Click" Height="40" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="{StaticResource JmBrush.Border}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Acciones" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource JmBrush.TextPrimary}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Cargar archivo TXT" Click="LoadTxt_Click" Height="40" Margin="0,14,0,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Reparar catálogo" Click="RepairCatalog_Click" Height="40" Margin="0,8,0,0" />
                            <Button Content="Reprovisionar" Click="Reprovision_Click" Height="40" Margin="0,18,0,0" Background="#FEF2F2" Foreground="{StaticResource JmBrush.Error}" BorderBrush="#FECACA" BorderThickness="1" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource JmBrush.Border}" BorderThickness="0,1,0,0" Background="White">
            <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Built by Jack Mnt" Foreground="{StaticResource JmBrush.TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Versión 2.0.2" Foreground="{StaticResource JmBrush.TextSecondary}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
